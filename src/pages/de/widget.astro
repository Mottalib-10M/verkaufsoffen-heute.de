---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'de';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'termin-finder', h2: 'Termin-Finder', text: 'Stadt oder Land wählen: Ihre Leser sehen die nächsten verkaufsoffenen Sonntage mit Quelle und können sie in ihren Kalender übernehmen.', t: 'Termin-Finder verkaufsoffene Sonntage', h: 900 },
  { name: 'sonntag-pruefen', h2: 'Sonntag prüfen', text: 'Land und Sonntag wählen: Der Rechner sagt, ob das Landesgesetz eine Freigabe zulässt, und nennt den Grund, wenn nicht.', t: 'Verkaufsoffenen Sonntag prüfen', h: 700 },
];
---
<PageLayout title="Termin-Finder kostenlos einbinden: verkaufsoffene Sonntage" description="Den Termin-Finder für verkaufsoffene Sonntage kostenlos per iframe einbinden: Code kopieren, neue Termine und Absagen erscheinen von selbst auf Ihrer Seite." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Start', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Termin-Finder einbinden</h1>
    <p class="mt-3 text-lg text-navy-700">Für Stadtmarketing, Vereine und Lokalzeitungen: einmal kopieren, neue Termine erscheinen von selbst.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>Für die englische Fassung ersetzen Sie <code>/embed/de/</code> durch <code>/embed/en/</code>. Bedingungen: Der Quellenlink unter dem Werkzeug bleibt sichtbar, das Werkzeug wird nicht verändert und ohne Gewähr bereitgestellt. Was Ihre Leser eingeben, bleibt auf deren Gerät. Fragen über die <a href={route('contact', lang)}>Kontaktseite</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/termin-finder/`} title="Termin-Finder" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
